   "locked": false
  },
  {
   "id": "tex-0251",
   "type": "text",
   "x": 1510,
   "y": 3148.0,
   "width": 1080,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
