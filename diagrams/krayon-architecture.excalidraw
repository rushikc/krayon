   "seed": 903292334,
   "version": 1,
   "versionNonce": 1776268929,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792236298564,
   "link": null,
   "locked": false,
   "text": "Error codes (errorInfo.code)\nSCHEMA_INVALID: zod / validateSegment still failing after every attempt \u2192 422\nNOT_JSON: model output was not JSON \u2192 422\nMAX_TOKENS \u00b7 TIMEOUT \u00b7 UPSTREAM: the model call failed \u2192 502 \u00b7 no AI backend configured \u2192 503 UPSTREAM\nerrorInfo = {code, message, issues[{path, message}], attempts}, stored on failed docs and sent on\n*.failed events. HTTP codes apply to POST /api/ai/generate; the course pipeline reports them as docs and\nevents instead.",
   "originalText": "Error codes (errorInfo.code)\nSCHEMA_INVALID: zod / validateSegment still failing after every attempt \u2192 422\nNOT_JSON: model output was not JSON \u2192 422\nMAX_TOKENS \u00b7 TIMEOUT \u00b7 UPSTREAM: the model call failed \u2192 502 \u00b7 no AI backend configured \u2192 503 UPSTREAM\nerrorInfo = {code, message, issues[{path, message}], attempts}, stored on failed docs and sent on *.failed events. HTTP codes apply to POST /api/ai/generate; the course pipeline reports them as docs and events instead.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-0248",
   "lineHeight": 1.25,
   "baseline": 128,
   "autoResize": false
  },
  {
   "id": "rec-0250",
   "type": "rectangle",
   "x": 1500,
