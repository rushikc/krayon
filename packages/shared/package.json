{
  "name": "@krayon/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remotion": {
      "types": "./dist/remotion/public.d.ts",
      "import": "./dist/remotion/public.js"
    },
    "./remotion-entry": "./dist/remotion/entry.js"
  },
  "scripts": {
