    "test": "vitest run"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.2.8",
    "remotion": "^4.0.536",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
