VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# local uses the Vite /api proxy. gcp talks to Cloud Run and Firestore realtime.
VITE_BACKEND=local
# Production: put the krayon-api Cloud Run URL in frontend/.env.production (gitignored). Never commit it.
VITE_API_BASE_URL=
# Where the dev proxy sends /api (default http://localhost:8787)
LOCAL_BACKEND_URL=
# reCAPTCHA Enterprise site key for App Check. Required when VITE_BACKEND=gcp.
VITE_RECAPTCHA_SITE_KEY=
# Optional App Check debug token for localhost (Firebase console → App Check → Manage debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=
