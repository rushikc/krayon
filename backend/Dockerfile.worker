FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY backend ./backend
RUN npm ci --ignore-scripts && npm run build -w @krayon/shared && npm run build -w @krayon/pipeline && npm run build -w @krayon/api && npm run build -w @krayon/backend

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
# No Chrome. Request timeout is set on the Cloud Run service (>= 1800s).
CMD ["node", "backend/dist/worker.js"]
