# Reference only: 30-deploy-run.sh sets Cloud Run env; keep in sync with ENV_COMMON.
PORT=8080
REGION=asia-south1
GOOGLE_CLOUD_PROJECT=krayon-ai
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENCY=5
CHAPTER_CONCURRENCY=3
RENDER_CONCURRENCY=2
MAX_REVIEW_ROUNDS=2
REVIEW_PASS_SCORE=8
RENDER_TIMEOUT_MS=90000
TTS_ENABLED=true
TTS_VOICE=en-US-Chirp3-HD-Charon
TTS_CONCURRENCY=4
TTS_QUOTA_PROJECT=krayon-ai
BUCKET=krayon-ai.firebasestorage.app
WORKER_URL=
RENDERER_URL=
TASKS_INVOKER_EMAIL=krayon-tasks@krayon-ai.iam.gserviceaccount.com
TASK_MAX_ATTEMPTS=3
STALE_MINUTES=15
CAP_UPLOADS_PER_VISITOR_DAY=2
CAP_COURSES_GLOBAL_DAY=10
CAP_LESSON_RENDERS_GLOBAL_DAY=40
CAP_REGENERATES_GLOBAL_DAY=40
CAP_ASK_GLOBAL_DAY=300
