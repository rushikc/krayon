PORT=8080
REGION=asia-south1
GOOGLE_CLOUD_PROJECT=krayon-ai
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
BUCKET=krayon-ai.firebasestorage.app
# Set at deploy time via 30-deploy-run.sh --origins; never commit real values.
CORS_ORIGINS=https://<your-site>.web.app,https://<your-site>.firebaseapp.com
APP_CHECK_ENFORCE=true
WORKER_URL=
TASKS_INVOKER_EMAIL=krayon-tasks@krayon-ai.iam.gserviceaccount.com
