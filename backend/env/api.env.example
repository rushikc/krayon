# Reference only: 30-deploy-run.sh sets Cloud Run env; keep in sync with ENV_COMMON.
PORT=8080
REGION=asia-south1
GOOGLE_CLOUD_PROJECT=krayon-ai
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-flash
BUCKET=krayon-ai.firebasestorage.app
# Set at deploy time via 30-deploy-run.sh --origins; never commit real values.
CORS_ORIGINS=https://<site-id>.web.app,https://<site-id>.firebaseapp.com
# Script default is false. Flip to true after App Check is verified in production.
APP_CHECK_ENFORCE=false
WORKER_URL=
TASKS_INVOKER_EMAIL=krayon-tasks@krayon-ai.iam.gserviceaccount.com
TASK_MAX_ATTEMPTS=3
STALE_MINUTES=15
CAP_UPLOADS_PER_VISITOR_DAY=2
CAP_COURSES_GLOBAL_DAY=10
CAP_LESSON_RENDERS_GLOBAL_DAY=40
CAP_REGENERATES_GLOBAL_DAY=40
CAP_ASK_GLOBAL_DAY=300
