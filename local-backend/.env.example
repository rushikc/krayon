# AI backend. Default: Vertex AI, authenticated with gcloud Application Default Credentials.
# Run `gcloud auth application-default login` once. No API keys belong in source.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=krayon-ai
GOOGLE_CLOUD_LOCATION=global
# Optional fallback (Google AI Studio key), used only when Vertex is off or no project is set.
GEMINI_API_KEY=
# Flash reads the structure, writes chapters, lessons, and scenes, and reviews rendered keyframes.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-2.5-flash
# Where the mock Firestore (SQLite) and mock Cloud Storage files live.
DATA_DIR=./data
LOG_DIR=./logs
# Comma-separated origins allowed to call the API directly (the Vite proxy doesn't need this).
CORS_ORIGINS=http://localhost:5173
PORT=8787
# Logging: DEBUG also logs docstore/storage operations and Gemini response text.
LOG_LEVEL=INFO
# Max characters of each request/response body written to the logs.
LOG_BODY_MAX=2000
# Segment limits. Repair fixes schema issues. Review re-renders until the score passes.
MAX_REPAIR_ROUNDS=2
MAX_REVIEW_ROUNDS=1
REVIEW_PASS_SCORE=8
# A segment is tried 1 + SEGMENT_RETRIES times before it (and its lesson) is marked failed.
SEGMENT_RETRIES=2
# Chapters written at once.
CHAPTER_CONCURRENCY=3
# Gemini calls in flight at once, across all courses (clicked lesson first, then the viewed course).
GEMINI_MAX_CONCURRENCY=5
# Keyframe renders at once, separate from the Gemini limit.
RENDER_CONCURRENCY=2
# Still frames sent to the review model per round.
RENDER_KEYFRAMES_MAX=8
